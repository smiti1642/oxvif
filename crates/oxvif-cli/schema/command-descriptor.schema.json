{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smiti1642/oxvif/releases/schema/v3/command-descriptor.schema.json",
  "title": "oxvif command descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "summary",
    "risk",
    "authentication_required",
    "mutates_device",
    "retryable",
    "arguments",
    "output",
    "possible_errors",
    "examples"
  ],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "summary": { "type": "string", "minLength": 1 },
    "risk": { "enum": ["read", "write", "dangerous"] },
    "authentication_required": { "type": "boolean" },
    "mutates_device": { "type": "boolean" },
    "retryable": { "type": "boolean" },
    "arguments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "required", "description"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "description": { "type": "string", "minLength": 1 },
          "allowed_values": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "description"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "possible_errors": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
      "uniqueItems": true
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
