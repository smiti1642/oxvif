{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/smiti1642/oxvif/releases/schema/v3/oxvif-envelope.schema.json",
  "title": "oxvif structured stdout envelope",
  "description": "Schema version 3 base contract. Command-specific data is discriminated by data.kind and may add fields.",
  "oneOf": [
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "ok", "data", "warnings", "meta"],
      "properties": {
        "schema_version": { "const": "3" },
        "ok": { "type": "boolean" },
        "data": { "$ref": "#/$defs/commandData" },
        "warnings": {
          "type": "array",
          "items": { "$ref": "#/$defs/warning" }
        },
        "meta": { "$ref": "#/$defs/meta" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "ok", "error", "meta"],
      "properties": {
        "schema_version": { "const": "3" },
        "ok": { "const": false },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "message": { "type": "string", "minLength": 1 },
            "retryable": { "type": "boolean" },
            "suggested_action": { "type": "string", "minLength": 1 }
          }
        },
        "meta": { "$ref": "#/$defs/meta" }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elapsed_ms"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "device_id": { "type": "string", "minLength": 1 },
        "selected_by": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "elapsed_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "commandData": {
      "type": "object",
      "required": ["kind"],
      "allOf": [
        {
          "if": { "required": ["operation"], "properties": { "kind": { "const": "fleet_item" }, "operation": { "const": "diagnose" } } },
          "then": { "properties": { "item": { "$ref": "#/$defs/diagnoseItem" } } }
        },
        {
          "if": { "required": ["operation"], "properties": { "kind": { "const": "fleet_diagnostic" }, "operation": { "const": "diagnose" } } },
          "then": { "properties": { "items": { "type": "array", "items": { "$ref": "#/$defs/diagnoseItem" } } } }
        },
        {
          "if": { "required": ["operation", "result"], "properties": { "kind": { "const": "device_diagnostic" }, "operation": { "const": "diagnose" } } },
          "then": { "properties": { "result": { "$ref": "#/$defs/diagnoseReport" } } }
        },
        {
          "if": { "required": ["operation", "result"], "properties": { "kind": { "const": "device_diagnostic" }, "operation": { "const": "media.snapshot-save" } } },
          "then": { "properties": { "result": { "$ref": "#/$defs/snapshotReport" } } }
        },
        {
          "if": { "required": ["operation", "result"], "properties": { "kind": { "const": "device_diagnostic" }, "operation": { "const": "config.export" } } },
          "then": { "properties": { "result": { "type": "object", "required": ["saved_to", "complete", "inventory"], "properties": { "saved_to": { "type": "string" }, "complete": { "type": "boolean" }, "inventory": { "$ref": "#/$defs/configInventory" } } } } }
        },
        {
          "if": { "required": ["operation", "result"], "properties": { "kind": { "const": "device_diagnostic" }, "operation": { "const": "config.diff" } } },
          "then": { "properties": { "result": { "$ref": "#/$defs/configDiffReport" } } }
        }
      ],
      "properties": {
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
      }
    },
    "diagnoseItem": {
      "type": "object",
      "properties": { "result": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/diagnoseReport" }] } }
    },
    "workflowStage": {
      "type": "object",
      "required": ["name", "status", "elapsed_ms", "error_code", "detail", "next_step", "data"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail", "unsupported", "not_tested"] },
        "elapsed_ms": { "type": "integer", "minimum": 0 },
        "error_code": { "type": ["string", "null"] },
        "detail": { "type": "string" },
        "next_step": { "type": "string" },
        "data": {},
        "not_tested_reason": { "enum": ["prerequisite_failed", "not_implemented"] }
      },
      "allOf": [{
        "if": { "properties": { "name": { "enum": ["media_profiles", "profile_selection"] } } },
        "then": { "properties": { "data": {
          "type": ["object", "null"],
          "properties": {
            "reason_code": { "enum": ["PROFILE_SELECTION_REQUIRED", "PROFILE_NOT_FOUND", "PROFILE_QUERY_FAILED", "NO_PROFILES_AVAILABLE", "PROFILE_SELECTION_CANCELLED", "PROFILE_INTERACTION_FAILED"] },
            "requested_profile": { "type": ["string", "null"] },
            "candidates": { "type": "array", "items": {
              "type": "object", "required": ["name", "token"],
              "properties": { "name": { "type": "string" }, "token": { "type": "string" } }
            } }
          }
        } } }
      }]
    },
    "diagnoseReport": {
      "type": "object",
      "required": ["failed", "complete", "stages", "playback_verified"],
      "properties": {
        "failed": { "type": "integer", "minimum": 0 },
        "complete": { "type": "boolean" },
        "playback_verified": { "const": false },
        "selected_profile": { "type": ["string", "null"] },
        "summary": {
          "type": "object",
          "required": ["passed", "failed", "unsupported", "not_tested"],
          "properties": {
            "passed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "unsupported": { "type": "integer", "minimum": 0 },
            "not_tested": { "type": "integer", "minimum": 0 }
          }
        },
        "stages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/workflowStage" } }
      }
    },
    "snapshotReport": {
      "type": "object",
      "required": ["saved_to", "bytes", "image_type", "profile", "validation"],
      "properties": {
        "saved_to": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 },
        "image_type": { "enum": ["jpeg", "png", "bmp"] },
        "profile": { "type": "string", "minLength": 1 },
        "validation": { "const": "signature_only_not_full_decode" }
      }
    },
    "configInventory": {
      "type": "object",
      "required": ["inventory_version", "identity", "sections"],
      "properties": {
        "inventory_version": { "const": 1 },
        "identity": {
          "type": "object",
          "required": ["manufacturer", "model", "serial_number", "hardware_id"],
          "additionalProperties": { "type": "string" }
        },
        "sections": {
          "type": "object",
          "required": ["hostname", "ntp", "dns", "interfaces", "protocols", "gateway", "profiles", "video_encoders"],
          "additionalProperties": { "$ref": "#/$defs/workflowStage" }
        }
      }
    },
    "configDiffReport": {
      "type": "object",
      "required": ["complete", "matches", "changes", "incomparable_sections"],
      "properties": {
        "complete": { "type": "boolean" },
        "matches": { "type": ["boolean", "null"] },
        "incomparable_sections": { "type": "array", "items": { "type": "string" } },
        "changes": {
          "type": "array",
          "items": {
            "type": "object", "required": ["path", "before", "after", "before_present", "after_present"],
            "properties": { "path": { "type": "string" }, "before": {}, "after": {}, "before_present": { "type": "boolean" }, "after_present": { "type": "boolean" } }
          }
        }
      }
    }
  }
}
